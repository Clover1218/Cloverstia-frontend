---
/**
 * 首屏落地页（/）
 * - 背景：public/backgorund_winter.png（全屏 cover）
 * - 顶部：public/header_font.png 站点字体图
 * - 按钮：Blog → /blog/，Minecraft → https://mc.cloverstia.site
 * - 飘雪特效：通过下方 SNOW_ENABLED 开关控制，改为 false 即可整体关闭
 */
import Layout from "@/layouts/Layout.astro";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

// ===== 飘雪特效开关（后期增删改这里即可） =====
const SNOW_ENABLED = true;
const SNOW_COUNT = 50; // 雪花数量

// 确定性伪随机，保证每次构建雪花分布一致
function rand(seed: number): number {
  const x = Math.sin(seed * 127.1 + 311.7) * 43758.5453;
  return x - Math.floor(x);
}

const snowflakes = Array.from({ length: SNOW_ENABLED ? SNOW_COUNT : 0 }, (_, i) => ({
  left: rand(i + 1) * 100, // 水平位置 %
  size: 2 + rand(i + 2) * 5, // 直径 px
  duration: 9 + rand(i + 3) * 14, // 下落时长 s
  delay: -rand(i + 4) * 20, // 负延迟让雪花开场即分布全屏
  opacity: 0.25 + rand(i + 5) * 0.6,
  drift: (rand(i + 6) - 0.5) * 240, // 水平漂移 px
  blur: rand(i + 7) > 0.75 ? 1.5 : 0, // 少量雪花虚化，制造景深
}));

const BG_URL = getAssetPath("backgorund_winter.png");
const FONT_URL = getAssetPath("header_font.png");

// ===== 备案信息（直接引用 src/config.ts 中的 site 配置）=====
const ICP_NO = config.site.icpRecord;
const ICP_URL = "https://beian.miit.gov.cn"; // ICP 官方备案查询站（config 未单独提供）
const PS_NO = config.site.policeRecord;
const PS_URL = config.site.policeRecordUrl;
---

<Layout>
  <main class="landing" style={`--bg-url: url('${BG_URL}')`}>
    <!-- 飘雪层 -->
    {
      snowflakes.map(f => (
        <span
          class="snowflake"
          style={`--left:${f.left}%; --size:${f.size}px; --duration:${f.duration}s; --delay:${f.delay}s; --opacity:${f.opacity}; --drift:${f.drift}px; --blur:${f.blur}px;`}
          aria-hidden="true"
        />
      ))
    }

    <div class="landing-content">
      <img class="site-font fade-in" src={FONT_URL} alt="Cloverstia" />
      <nav class="landing-nav fade-in fade-in-delay" aria-label="站点导航">
        <a class="glass-btn" href="/blog/">Blog</a>
        <a
          class="glass-btn"
          href="https://mc.cloverstia.site"
          target="_blank"
          rel="noopener noreferrer"
        >
          Minecraft
        </a>
      </nav>
    </div>

    <!-- 底部居中的备案信息（方案 A） -->
    <footer class="beian fade-in fade-in-delay">
      <a class="beian-link" href={ICP_URL} target="_blank" rel="noopener noreferrer">
        {ICP_NO}
      </a>
      <span class="beian-sep" aria-hidden="true">·</span>
      <a class="beian-link beian-ps" href={PS_URL} target="_blank" rel="noopener noreferrer">
        <svg
          class="ps-icon"
          viewBox="0 0 24 24"
          width="13"
          height="13"
          aria-hidden="true"
        >
          <path
            d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5l-8-3Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linejoin="round"
          ></path>
          <path
            d="M9 11.5 11 13.5 15 9"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        {PS_NO}
      </a>
    </footer>
  </main>
</Layout>

<style>
  .landing {
    position: relative;
    min-height: 100dvh;
    overflow: hidden;
    background-image:
      linear-gradient(to bottom, rgba(10, 20, 35, 0.08), rgba(10, 20, 35, 0.22)),
      var(--bg-url);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    flex-direction: column;
  }

  .landing-content {
    position: relative;
    z-index: 10;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(2.5rem, 8vh, 5rem);
    padding: clamp(1.5rem, 6vh, 4rem) 1.5rem;
  }

  .site-font {
    width: min(72vw, 30rem);
    height: auto;
    filter: drop-shadow(0 2px 12px rgba(20, 35, 60, 0.35));
  }

  .landing-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 4vw, 2.5rem);
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ===== 毛玻璃雪色按钮 ===== */
  .glass-btn {
    display: inline-block;
    padding: 0.85rem 2.75rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.16);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #fff;
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-decoration: none;
    box-shadow:
      0 4px 24px rgba(20, 35, 60, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    transition:
      background 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .glass-btn:hover,
  .glass-btn:focus-visible {
    background: rgba(255, 255, 255, 0.32);
    transform: translateY(-3px);
    box-shadow:
      0 8px 32px rgba(20, 35, 60, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  /* ===== 飘雪 ===== */
  .snowflake {
    position: fixed;
    top: 0;
    left: var(--left);
    width: var(--size);
    height: var(--size);
    background: #fff;
    border-radius: 50%;
    opacity: var(--opacity);
    filter: blur(var(--blur));
    pointer-events: none;
    z-index: 5;
    animation: snow-fall var(--duration) linear var(--delay) infinite;
  }

  @keyframes snow-fall {
    0% {
      transform: translate3d(0, -8vh, 0);
    }
    100% {
      transform: translate3d(var(--drift), 108vh, 0);
    }
  }

  /* ===== 入场淡入 ===== */
  .fade-in {
    animation: fade-up 1.1s ease-out both;
  }
  .fade-in-delay {
    animation-delay: 0.35s;
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 尊重系统"减少动态效果"设置 */
  @media (prefers-reduced-motion: reduce) {
    .snowflake {
      animation: none;
      display: none;
    }
    .fade-in {
      animation: none;
    }
  }

  @media (max-width: 480px) {
    .glass-btn {
      padding: 0.75rem 2.25rem;
      font-size: 1.05rem;
    }
  }

  /* ===== 底部居中备案信息（方案 A）===== */
  .beian {
    position: fixed;
    left: 0;
    right: 0;
    bottom: clamp(0.75rem, 3vh, 1.5rem);
    /* 用 left/right + margin auto 居中，避免 transform 与 fade-in 动画互相覆盖 */
    margin-inline: auto;
    width: fit-content;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
    max-width: calc(100vw - 2rem);
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    font-size: 12px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 4px rgba(10, 20, 35, 0.45);
  }

  .beian-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .beian-link:hover,
  .beian-link:focus-visible {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .beian-sep {
    opacity: 0.6;
  }

  .ps-icon {
    flex-shrink: 0;
  }

  /* 尊重系统"减少动态效果"设置 */
  @media (prefers-reduced-motion: reduce) {
    .beian.fade-in {
      animation: none;
    }
  }

  @media (max-width: 360px) {
    .beian {
      flex-direction: column;
      gap: 0.25rem;
      border-radius: 12px;
    }
    .beian-sep {
      display: none;
    }
  }
</style>
